{
  "name": "nz-co-fuzion/bpointprocessor",
  "description": "BPoint Payment Processor for CiviCRM - Commonwealth Bank Payment Gateway",
  "type": "civicrm-extension",
  "license": "AGPL-3.0-only",
  "authors": [
    {
      "name": "Your Organization",
      "email": "dev@yourorganization.com"
    }
  ],
  "require": {
    "civicrm/core": "~6.0",
    "php": "^7.4|^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.0"
  },
  "repositories": {
    "civicrm": {
      "type": "composer",
      "url": "https://lab.civicrm.org/api/v4/composer/"
    }
  },
  "extra": {
    "civicrm": {
      "require-template": false,
      "installer-name": "nz.co.fuzion.bpointprocessor",
      "installer-paths": {
        "civicrm/extensions/{installer-name}/": ["type:civicrm-extension"]
      }
    }
  }
}
